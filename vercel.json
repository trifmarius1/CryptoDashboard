{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/yahoo/:path*",
      "destination": "https://query1.finance.yahoo.com/:path*"
    },
    {
      "source": "/api/coingecko/:path*",
      "destination": "https://api.coingecko.com/:path*"
    },
    {
      "source": "/api/coinpaprika/:path*",
      "destination": "https://api.coinpaprika.com/:path*"
    },
    {
      "source": "/api/coinlore/:path*",
      "destination": "https://api.coinlore.net/:path*"
    },
    {
      "source": "/api/binance/:path*",
      "destination": "https://api.binance.com/:path*"
    },
    {
      "source": "/api/cryptocompare/:path*",
      "destination": "https://min-api.cryptocompare.com/:path*"
    },
    {
      "source": "/api/fng/:path*",
      "destination": "https://api.alternative.me/:path*"
    },
    {
      "source": "/api/fx/:path*",
      "destination": "https://api.frankfurter.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        },
        {
          "key": "Accept",
          "value": "application/json"
        }
      ]
    }
  ]
}
